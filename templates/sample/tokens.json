{
  "_comment": "Northwind Cloud 샘플 테마의 디자인 토큰 (단일 소스). 여기 값을 고치고 `npm run template:build`를 돌리면 template.html과 generated/v2-*.html이 다시 구워진다 — 생성물을 직접 수정하지 말 것. style.*는 여러 모듈이 공유하는 규칙(mixin), 나머지는 원자 토큰. 색 변형(variant)별 accent·tint는 theme.mjs가 빌드 때 덮어쓴다.",

  "color": {
    "ink": "#141920",
    "muted": "#8a8f98",
    "accent": "#1F5FBF",
    "black": "#000000",
    "white": "#ffffff",
    "line": "#e9edf3",
    "outerBg": "#f3f5f8",
    "tintHero": "#eef4fd",
    "tintSection": "#f4f8fe",
    "tintFooter": "#f7faff",
    "tintCard": "#f8fbff",
    "tableHeadBg": "#dfe9f9",
    "tableBorder": "rgba(0,0,0,0.04)",
    "railLine": "#d6e4fa",
    "hashtagBg": "#eaf1fc",
    "grayLight": "#bbbbbb",
    "brandAFallback": "#1F5FBF",
    "brandBFallback": "#0F766E"
  },

  "gradient": {
    "accent": "linear-gradient(180deg,#1F5FBF,#3B82F6)",
    "brandA": "linear-gradient(90deg,#3B82F6,#1F5FBF)",
    "brandB": "linear-gradient(90deg,#14B8A6,#0F766E)"
  },

  "font": {
    "stack": "'Pretendard','Inter','Segoe UI','Malgun Gothic','맑은 고딕',sans-serif",
    "label": "'Inter','Pretendard','Segoe UI',sans-serif"
  },

  "radius": {
    "card": "28px",
    "cardSm": "14px",
    "quote": "18px",
    "pill": "100px",
    "sm": "10px"
  },

  "shadow": {
    "card": "0 4px 20px rgba(0,0,0,0.10)",
    "cardSoft": "0 4px 20px rgba(0,0,0,0.06)",
    "photo": "0 4px 40px rgba(0,0,0,0.2)",
    "glass": "0 4px 30px rgba(0,0,0,0.02)"
  },

  "style": {
    "eyebrow": "font-size:12px; font-weight:600; letter-spacing:1.4px; color:{{color.ink}}; font-family:{{font.label}};",
    "sectionTitle": "font-size:24px; font-weight:700; color:{{color.ink}}; letter-spacing:-0.4px; padding-top:10px; padding-bottom:26px;",
    "sectionWhite": "background-color:{{color.white}}; padding:42px 40px 42px 40px;",
    "sectionTint": "background-color:{{color.tintSection}}; padding:42px 40px 42px 40px;",
    "cardWhite": "background-color:{{color.white}}; border:1px solid {{color.line}}; border-radius:{{radius.card}}; box-shadow:{{shadow.card}};",
    "numBadge": "background:{{gradient.accent}}; background-color:{{color.accent}}; border-radius:50%; font-size:14px; font-weight:700; color:{{color.white}}; line-height:28px;",
    "dot": "background:{{gradient.accent}}; background-color:{{color.accent}}; border-radius:50%; font-size:0; line-height:0;",
    "wordmarkBrand": "font-size:20px; font-weight:800; background:{{gradient.brandA}}; background-color:{{color.brandAFallback}}; -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; color:{{color.brandAFallback}};",
    "spacer": "font-size:0; line-height:0;"
  }
}
